#!/bin/sh
# Chetter gh wrapper. Only explicitly reviewed read operations are allowed;
# writes and arbitrary API access must use Chetter's audited MCP tools.
set -eu

_blocked() {
  cat >&2 <<'EOF'
Chetter permits only an explicit set of read-only gh commands. GitHub writes
must use chetter_create_issue, chetter_issue_comment, chetter_create_pr, or
chetter_pr_review so signatures, artifacts, and audit records are preserved.
EOF
  exit 64
}

case "${1:-}:${2:-}" in
  issue:list|issue:view|issue:status) ;;
  pr:list|pr:view|pr:status|pr:checks|pr:diff) ;;
  repo:view) ;;
  run:list|run:view|run:watch) ;;
  workflow:list|workflow:view) ;;
  release:list|release:view) ;;
  search:issues|search:prs|search:repos|search:code|search:commits) ;;
  --version:|version:|help:*|--help:) exec /usr/local/bin/gh-real "$@" ;;
  *) _blocked ;;
esac

broker_token=""
if [ -n "${CHETTER_GITHUB_CREDENTIAL_URL:-}" ] && [ -n "${CHETTER_GITHUB_CREDENTIAL_TOKEN:-}" ]; then
  broker_token="$(
    printf 'request = "POST"\nheader = "Authorization: Bearer %s"\n' "$CHETTER_GITHUB_CREDENTIAL_TOKEN" |
      curl --fail --silent --show-error --config - "$CHETTER_GITHUB_CREDENTIAL_URL" 2>/dev/null
  )" || broker_token=""
fi

if [ -n "$broker_token" ]; then
  GITHUB_TOKEN= GH_TOKEN="$broker_token" exec /usr/local/bin/gh-real "$@"
fi
if [ -n "${GITHUB_TOKEN:-}" ]; then
  GH_TOKEN="$GITHUB_TOKEN" exec /usr/local/bin/gh-real "$@"
fi
exec /usr/local/bin/gh-real "$@"
